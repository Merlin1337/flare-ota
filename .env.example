# Copy to .env.production (and .env.staging, …) at the repo root. These files are gitignored.
# The setup script fills most of them for you: pnpm --filter @flare-ota/server setup -- --stage production
# Only NON-secret values go here. Secrets (signing key, preview secret, API tokens) stay in your
# keychain / password manager / CI secrets and reach the scripts through the environment.

# Cloudflare account that hosts the server (cf accounts list).
CLOUDFLARE_ACCOUNT_ID=

# Base name of the Worker and its resources. Staging appends -staging. Default: flare-ota
# FLARE_OTA_NAME=flare-ota

# Hostnames on a zone of that account. Devices bake the updates URL into their binary: keep it stable.
FLARE_OTA_UPDATES_HOST=ota.example.com
FLARE_OTA_DASHBOARD_HOST=ota-admin.example.com

# Who may open the dashboard (Cloudflare Access). Emails and/or whole email domains.
FLARE_OTA_ACCESS_EMAILS=you@example.com
# FLARE_OTA_ACCESS_EMAIL_DOMAINS=example.com

# Filled by the access script.
FLARE_OTA_ACCESS_TEAM_DOMAIN=
FLARE_OTA_ACCESS_AUD=

# Your app's URL scheme (app.json "scheme"), used in preview deep links.
FLARE_OTA_APP_SCHEME=myapp

# Optional: disable the Analytics Engine dataset (raw delivery events).
# FLARE_OTA_ANALYTICS=off

# Optional: /manifest requests per 10 s per IP before the WAF blocks (waf script). Default 30.
# FLARE_OTA_MANIFEST_RATE=30

# --- Secrets: export them in your shell or CI, never write them here ---
# FLARE_OTA_SIGNING_KEY      PEM private key matching your app's certificate
# FLARE_OTA_PREVIEW_SECRET   random string for preview links
# CLOUDFLARE_API_TOKEN       scoped deploy token in CI (pnpm --filter @flare-ota/server deploy-token)
